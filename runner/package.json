{
  "name": "threadbear-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Threadbear runner: a launchd daemon that drives the official Claude Code CLI and serves threads over a local WebSocket JSON-RPC API.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "tb": "bin/tb"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --import=./test/helpers/clean-env.ts --test --test-reporter=spec --test-timeout=300000 --test-force-exit \"test/unit/**/*.test.ts\"",
    "test:deploy": "bash test/deploy/run.sh",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 --test-timeout=600000 \"test/e2e/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "context-budget": "UPDATE_CONTEXT_BUDGET=1 node --test test/unit/context-budget.test.ts",
    "experiment-docs": "UPDATE_EXPERIMENT_DOCS=1 node --test test/unit/experiment-docs.test.ts",
    "parity-docs": "UPDATE_PARITY_DOCS=1 node --test --test-name-pattern=docs/parity test/unit/parity.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@sentry/node": "11.11.0",
    "convex": "1.49.0",
    "oxc-parser": "0.152.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
